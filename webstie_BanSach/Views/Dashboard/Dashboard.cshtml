@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <h3 class="mb-0">Dashboard</h3>
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="@Url.Action("Dashboard","Dashboard")">Trang chủ</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
                </ol>
            </div>
            <div class="col-sm-6 d-flex justify-content-end gap-2 mt-2 mt-sm-0">
                <select id="ddlDays" class="form-select" style="max-width:180px;">
                    <option value="7">7 ngày gần nhất</option>
                    <option value="30" selected>30 ngày gần nhất</option>
                    <option value="90">90 ngày gần nhất</option>
                </select>
                <button id="btnReload" class="btn btn-outline-primary" type="button"><i class="bi bi-arrow-clockwise"></i> Tải lại</button>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <div class="row g-3 mb-1">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="small-box text-bg-primary">
                    <div class="inner">
                        <h3 id="kpiProducts">0</h3>
                        <p>Sản phẩm</p>
                    </div>
                    <div class="small-box-icon"><i class="bi bi-book"></i></div>
                    <a href="@Url.Action("BookList","BookMgmt")" class="small-box-footer link-light">Xem chi tiết <i class="bi bi-link-45deg"></i></a>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="small-box text-bg-success">
                    <div class="inner">
                        <h3 id="kpiRevenue">0</h3>
                        <p>Doanh thu</p>
                    </div>
                    <div class="small-box-icon"><i class="bi bi-cash-stack"></i></div>
                    <a href="@Url.Action("Revenue","Revenue")" class="small-box-footer link-light">Xem chi tiết <i class="bi bi-link-45deg"></i></a>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="small-box text-bg-warning">
                    <div class="inner">
                        <h3 id="kpiOrders">0</h3>
                        <p>Đơn hàng</p>
                    </div>
                    <div class="small-box-icon"><i class="bi bi-bag-check"></i></div>
                    <a href="@Url.Action("OrderList","OrderMgmt")" class="small-box-footer link-dark">Xem chi tiết <i class="bi bi-link-45deg"></i></a>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="small-box text-bg-danger">
                    <div class="inner">
                        <h3 id="kpiCustomers">0</h3>
                        <p>Khách hàng</p>
                    </div>
                    <div class="small-box-icon"><i class="bi bi-people"></i></div>
                    <a href="@Url.Action("CustomerList","CustomerMgmt")" class="small-box-footer link-light">Xem chi tiết <i class="bi bi-link-45deg"></i></a>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-lg-8">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h3 class="card-title mb-0">Đơn hàng gần đây</h3>
                        <a href="@Url.Action("OrderList","OrderMgmt")" class="btn btn-sm btn-outline-primary">Xem tất cả</a>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0 align-middle">
                                <thead>
                                    <tr>
                                        <th>Mã</th>
                                        <th>Khách hàng</th>
                                        <th>Thời gian</th>
                                        <th class="text-end">Tổng tiền</th>
                                        <th>Trạng thái</th>
                                        <th style="width:90px;">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody id="recentOrdersBody">
                                    <tr><td colspan="6" class="text-center text-muted py-3">Đang tải dữ liệu...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card mb-3">
                    <div class="card-header"><h3 class="card-title mb-0">Danh mục nổi bật</h3></div>
                    <div class="card-body" id="topCategoriesBox"><div class="text-muted">Đang tải...</div></div>
                </div>
                <div class="card">
                    <div class="card-header"><h3 class="card-title mb-0">Cảnh báo sắp hết hàng</h3></div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush" id="lowStockBox">
                            <li class="list-group-item text-muted">Đang tải...</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
(function () {
    function esc(t) { return $('<div/>').text(t == null ? '' : t).html(); }
    function fmtMoney(v) { return Number(v || 0).toLocaleString('vi-VN') + ' đ'; }
    function statusBadge(s) {
        s = (s || '').toUpperCase();
        if (s.indexOf('COMPLETE') >= 0 || s.indexOf('DONE') >= 0) return '<span class="badge text-bg-success">' + esc(s) + '</span>';
        if (s.indexOf('CANCEL') >= 0 || s.indexOf('FAIL') >= 0) return '<span class="badge text-bg-danger">' + esc(s) + '</span>';
        if (s.indexOf('PEND') >= 0 || s.indexOf('NEW') >= 0) return '<span class="badge text-bg-warning">' + esc(s) + '</span>';
        return '<span class="badge text-bg-secondary">' + esc(s || 'N/A') + '</span>';
    }

    function render(d) {
        var k = d.Kpi || {};
        $('#kpiProducts').text(Number(k.ProductCount || 0).toLocaleString('vi-VN'));
        $('#kpiRevenue').text(fmtMoney(k.Revenue || 0));
        $('#kpiOrders').text(Number(k.OrderCount || 0).toLocaleString('vi-VN'));
        $('#kpiCustomers').text(Number(k.CustomerCount || 0).toLocaleString('vi-VN'));

        var orders = d.RecentOrders || [];
        if (!orders.length) {
            $('#recentOrdersBody').html('<tr><td colspan="6" class="text-center text-muted py-3">Không có dữ liệu</td></tr>');
        } else {
            var html = '';
            orders.forEach(function (o) {
                var detailUrl = '@Url.Action("OrderDetail","OrderMgmt")' + '?id=' + encodeURIComponent(o.OrderId);
                html += '<tr>' +
                    '<td>' + esc(o.OrderCode) + '</td>' +
                    '<td>' + esc(o.BuyerName) + '</td>' +
                    '<td>' + esc(o.CreatedAt) + '</td>' +
                    '<td class="text-end">' + fmtMoney(o.GrandTotal) + '</td>' +
                    '<td>' + statusBadge(o.Status) + '</td>' +
                    '<td><a class="btn btn-sm btn-outline-secondary" href="' + detailUrl + '">Chi tiết</a></td>' +
                    '</tr>';
            });
            $('#recentOrdersBody').html(html);
        }

        var cats = d.TopCategories || [];
        if (!cats.length) { $('#topCategoriesBox').html('<div class="text-muted">Chưa có dữ liệu</div>'); }
        else {
            var chtml = '';
            cats.forEach(function (c) {
                chtml += '<div class="mb-2">' +
                    '<div class="d-flex justify-content-between small"><span>' + esc(c.Name) + '</span><span>' + esc(c.Value) + '</span></div>' +
                    '<div class="progress" role="progressbar" aria-valuenow="' + c.Percent + '" aria-valuemin="0" aria-valuemax="100">' +
                    '<div class="progress-bar" style="width:' + (c.Percent || 0) + '%"></div></div></div>';
            });
            $('#topCategoriesBox').html(chtml);
        }

        var lows = d.LowStockBooks || [];
        if (!lows.length) { $('#lowStockBox').html('<li class="list-group-item text-muted">Không có cảnh báo</li>'); }
        else {
            var lhtml = '';
            lows.forEach(function (b) {
                var badge = b.Level === 'danger' ? 'text-bg-danger' : (b.Level === 'warning' ? 'text-bg-warning' : 'text-bg-info');
                lhtml += '<li class="list-group-item d-flex justify-content-between align-items-center">' +
                    '<span class="me-2">' + esc(b.Name) + '</span>' +
                    '<span class="badge ' + badge + ' rounded-pill">Tồn: ' + esc(b.Stock) + '</span></li>';
            });
            $('#lowStockBox').html(lhtml);
        }
    }

    function load() {
        var days = parseInt($('#ddlDays').val(), 10) || 30;
        $('#recentOrdersBody').html('<tr><td colspan="6" class="text-center text-muted py-3">Đang tải dữ liệu...</td></tr>');
        $.ajax({
            url: '@Url.Action("GetDashboard","Dashboard")',
            type: 'POST',
            data: { days: days },
            success: function (res) {
                console.log('[Dashboard] GetDashboard response:', res);
                if (res && res.ErrCode === 1 && res.Data) { render(res.Data); }
                else {
                    var msg = (res && res.ErrDesc ? res.ErrDesc : 'Không tải được dashboard') + (res && res.ErrCode !== undefined ? ' [ErrCode: ' + res.ErrCode + ']' : '');
                    $('#recentOrdersBody').html('<tr><td colspan="6" class="text-center text-danger py-3">' + esc(msg) + '</td></tr>');
                    showToast(msg, 'error');
                }
            },
            error: function (xhr, status, error) {
                console.error('[Dashboard] GetDashboard error:', { status: status, error: error, httpStatus: xhr.status, responseText: xhr.responseText });
                var msg = 'Lỗi tải dashboard [HTTP ' + xhr.status + ' ' + error + ']';
                $('#recentOrdersBody').html('<tr><td colspan="6" class="text-center text-danger py-3">' + esc(msg) + '</td></tr>');
                showToast(msg, 'error');
            }
        });
    }

    $('#ddlDays').on('change', load);
    $('#btnReload').on('click', load);
    load();
})();
</script>
}
