@{
    ViewBag.Title = "Cập nhật tác giả";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var authorId = ViewBag.AuthorId;
}
<div class="app-content-header"><div class="container-fluid"><div class="row">
    <div class="col-sm-6"><h3 class="mb-0">Cập nhật tác giả</h3></div>
    <div class="col-sm-6 text-end"><a href="@Url.Action("AuthorList","AuthorMgmt")" class="btn btn-outline-secondary">Quay lại danh sách</a></div>
</div></div></div>
<div class="app-content"><div class="container-fluid"><div class="card"><div class="card-body">
    <form id="frm">
        <input type="hidden" id="txtId" value="@(authorId ?? 0)" />
        <div class="mb-3"><label class="form-label">Tên tác giả <span class="text-danger">*</span></label><input type="text" class="form-control" id="txtName" maxlength="150" /></div>
        <div class="mb-3"><label for="ddlStatus" class="form-label">Trạng thái</label><select class="form-select" id="ddlStatus"><option value="active">Hoạt động</option><option value="deleted">Đã xóa</option></select></div>
        <button type="submit" class="btn btn-primary" id="btnSave">Cập nhật</button>
    </form>
</div></div></div></div>
@section scripts {
<script>
(function(){
    var id=parseInt($('#txtId').val(),10)||0;
    function load(){ if(!id){showToast('Thiếu ID tác giả','error');return;} $.get('@Url.Action("GetAuthorInfo","AuthorMgmt")',{id:id},function(res){ console.log('[AuthorMgmt] GetAuthorInfo response:',res); if(res&&res.ErrCode===1&&res.Data){$('#txtName').val(res.Data.AuthorName||'');$('#ddlStatus').val(res.Data.IsDeleted?'deleted':'active');} else {var e=(res&&res.ErrDesc?res.ErrDesc:'Không thể tải thông tin')+(res&&res.ErrCode!==undefined?' [ErrCode: '+res.ErrCode+']':''); showToast(e,'error');} }).fail(function(x,s,e){console.error('[AuthorMgmt] GetAuthorInfo error:',{status:s,error:e,httpStatus:x.status,responseText:x.responseText}); showToast('Lỗi tải thông tin [HTTP '+x.status+' '+e+']','error');}); }
    $('#frm').on('submit',function(e){ e.preventDefault(); var name=$.trim($('#txtName').val()); if(!id||!name){showToast('Vui lòng nhập tên tác giả','error');return;} $('#btnSave').prop('disabled',true).text('Đang lưu...'); $.post('@Url.Action("Update","AuthorMgmt")',{txt_AuthorId:id,txt_AuthorName:name,chk_IsDeleted:($('#ddlStatus').val()==='deleted')},function(res){ console.log('[AuthorMgmt] Update response:',res); if(res&&res.ErrCode===1){showToast(res.ErrDesc||'Cập nhật thành công','success'); setTimeout(function(){window.location.href='@Url.Action("AuthorList","AuthorMgmt")';},700);} else {var e=(res&&res.ErrDesc?res.ErrDesc:'Cập nhật thất bại')+(res&&res.ErrCode!==undefined?' [ErrCode: '+res.ErrCode+']':''); showToast(e,'error');} }).fail(function(x,s,e){console.error('[AuthorMgmt] Update error:',{status:s,error:e,httpStatus:x.status,responseText:x.responseText}); showToast('Lỗi cập nhật [HTTP '+x.status+' '+e+']','error');}).always(function(){$('#btnSave').prop('disabled',false).text('Cập nhật');}); });
    load();
})();
</script>
}