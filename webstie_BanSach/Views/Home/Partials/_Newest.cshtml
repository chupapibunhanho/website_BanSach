<section class="container mt-4 mb-5 newest-books section-alt newest-shell"
         data-endpoint="@Url.Action("NewestPartial", "Home")">
 

  

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-3">
        <div class="section-heading">
            <h3 class="section-title m-0">Sách mới nhất</h3>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-link section-cta" title="Danh sách sách chưa triển khai" disabled>Xem tất cả</button>
        </div>
    </div>

    <div id="newest-loading" class="text-center py-4">
        <div class="spinner-border text-primary" role="status" aria-hidden="true"></div>
        <p class="mt-2 text-muted mb-0">Đang tải sách mới nhất...</p>
    </div>

    <div id="newest-error" class="alert alert-warning d-none" role="alert">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>
            <span data-newest-error>Không thể tải sách mới nhất.</span>
            <button type="button"
                    class="btn btn-sm btn-outline-secondary ms-auto"
                    data-newest-retry>
                Thử lại
            </button>
        </div>
    </div>

    <div id="newest-empty" class="text-muted d-none">
        Chưa có sách mới.
    </div>

    <div id="newest-container"
         class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-3 g-md-4 d-none"
         data-newest-container>
    </div>
</section>
