<section class="best-sellers container mt-4 mb-5 section-alt best-sellers-shell"
         data-endpoint="@Url.Action("BestSellersPartial", "Home")">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-3">
        <div class="section-heading">
            <h3 class="section-title m-0">Sách bán chạy</h3>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-link section-cta" title="Danh sách sách chưa triển khai" disabled>Xem tất cả</button>
        </div>
    </div>

    <div id="best-sellers-loading" class="text-center py-4">
        <div class="spinner-border text-primary" role="status" aria-hidden="true"></div>
        <p class="mt-2 text-muted mb-0">Đang tải sách bán chạy...</p>
    </div>

    <div id="best-sellers-error" class="alert alert-warning d-none" role="alert">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>
            <span data-best-sellers-error>Không thể tải sách bán chạy.</span>
            <button type="button"
                    class="btn btn-sm btn-outline-secondary ms-auto"
                    data-best-sellers-retry>
                Thử lại
            </button>
        </div>
    </div>

    <div id="best-sellers-empty" class="text-muted d-none">
        Chưa có dữ liệu sách bán chạy.
    </div>

    <div class="best-sellers-slider d-none" data-best-sellers-shell>
        <button type="button"
                class="slider-nav slider-nav--prev"
                data-best-sellers-prev
                aria-label="Xem sách bán chạy trước">
            <i class="bi bi-chevron-left" aria-hidden="true"></i>
        </button>

        <div class="best-sellers-list" data-best-sellers-container></div>

        <button type="button"
                class="slider-nav slider-nav--next"
                data-best-sellers-next
                aria-label="Xem sách bán chạy tiếp theo">
            <i class="bi bi-chevron-right" aria-hidden="true"></i>
        </button>
    </div>
</section>
