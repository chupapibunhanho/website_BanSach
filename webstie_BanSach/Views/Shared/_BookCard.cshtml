@model webstie_BanSach.Models.Book
@{
    var average = Math.Max(0, Math.Min(5, Model.AverageRating));
    var fullStars = (int)Math.Floor(average);
    var halfStar = average - fullStars >= 0.5 && fullStars < 5;
    var emptyStars = 5 - fullStars - (halfStar ? 1 : 0);
    var fallback = Url.Content("~/Content/Images/default-book.jpg");
    var image = string.IsNullOrWhiteSpace(Model.CoverUrl) ? fallback : Url.Content(Model.CoverUrl);
}
<div class="book-card card h-100 position-relative" data-book-id="@Model.BookId">
    <img src="@image" data-fallback="@fallback" class="card-img-top book-card__img" alt="@Model.Title" />
    <div class="card-body d-flex flex-column">
        <h5 class="card-title mb-1" title="@Model.Title">@Model.Title</h5>
        <div class="book-meta mb-1"><span class="book-rating" aria-label="@(average > 0 ? String.Format("Đánh giá {0:0.0} trên 5 sao", average) : "Chưa có đánh giá")">
            @for (var i = 0; i < fullStars; i++) { <i class="bi bi-star-fill" aria-hidden="true"></i> }
            @if (halfStar) { <i class="bi bi-star-half" aria-hidden="true"></i> }
            @for (var i = 0; i < emptyStars; i++) { <i class="bi bi-star" aria-hidden="true"></i> }
        </span></div>
        <div class="price mb-3">@String.Format("{0:N0} ₫", Model.Price)</div>
    </div>
    <div class="mt-auto card-actions" role="group" aria-label="Hành động sản phẩm" style="padding: 0.75rem;">
        <button type="button" class="btn btn-sm btn-add-to-cart" data-book-id="@Model.BookId" data-stock="@Model.Stock" title="@(Model.Stock <= 0 ? "Hết hàng" : "Giỏ hàng chưa triển khai")" disabled>
            <i class="bi @(Model.Stock <= 0 ? "bi-slash-circle" : "bi-cart-plus")" aria-hidden="true"></i><span>@(Model.Stock <= 0 ? "Hết hàng" : "Thêm vào giỏ")</span>
        </button>
        <button type="button" class="btn btn-sm btn-wishlist wishlist-btn" data-wishlist-id="@Model.BookId" title="Yêu thích chưa triển khai" aria-label="Yêu thích" disabled><i class="bi bi-heart" aria-hidden="true"></i></button>
    </div>
</div>
