<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - My ASP.NET Application</title>
    @Styles.Render("~/Content/css")
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="@Url.Content("~/Content/customer.css")" />
    @RenderSection("styles", required: false)
    @Scripts.Render("~/bundles/modernizr")
</head>
<body class="customer-site">
    @Html.Partial("_CustomerHeader")
    <div class="container body-content">
        <main class="customer-content">@RenderBody()</main>
        <hr />
        <footer class="site-footer">@Html.Partial("_CustomerFooter")</footer>
    </div>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <div class="modal fade" id="searchQuickModal" tabindex="-1" aria-labelledby="searchQuickTitle" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="searchQuickTitle">Xem nhanh sách</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div><div class="modal-body" id="searchQuickBody"></div></div></div></div>
    <script src="@Url.Content("~/Scripts/customer-search.js")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
