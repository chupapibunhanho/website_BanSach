@{
    ViewBag.Title = "Cập nhật nhà xuất bản";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var publisherId = ViewBag.PublisherId;
}
<div class="app-content-header"><div class="container-fluid"><div class="row">
    <div class="col-sm-6"><h3 class="mb-0">Cập nhật nhà xuất bản</h3></div>
    <div class="col-sm-6 text-end"><a href="@Url.Action("PublisherList","PublisherMgmt")" class="btn btn-outline-secondary">Quay lại danh sách</a></div>
</div></div></div>
<div class="app-content"><div class="container-fluid"><div class="card"><div class="card-body">
    <form id="frm">
        <input type="hidden" id="txtId" value="@(publisherId ?? 0)" />
        <div class="mb-3"><label class="form-label">Tên nhà xuất bản <span class="text-danger">*</span></label><input type="text" class="form-control" id="txtName" maxlength="200" /></div>
        <div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="chkIsDeleted"><label class="form-check-label" for="chkIsDeleted">Đánh dấu đã xóa (soft delete)</label></div>
        <button type="submit" class="btn btn-primary" id="btnSave">Cập nhật</button>
    </form>
</div></div></div></div>
@section scripts {
<script>
(function(){
    var id=parseInt($('#txtId').val(),10)||0;
    function load(){ if(!id){showToast('Thiếu ID nhà xuất bản','error');return;} $.ajax({url:'@Url.Action("GetPublisherInfo","PublisherMgmt")',type:'GET',data:{id:id},success:function(res){ console.log('[PublisherMgmt] GetPublisherInfo response:',res); if(res&&res.ErrCode===1&&res.Data){$('#txtName').val(res.Data.PublisherName||''); $('#chkIsDeleted').prop('checked',!!res.Data.IsDeleted);}else{showToast((res&&res.ErrDesc?res.ErrDesc:'Không tải được thông tin')+(res&&res.ErrCode!==undefined?' [ErrCode: '+res.ErrCode+']':''),'error');}},error:function(xhr,s,err){console.error('[PublisherMgmt] GetPublisherInfo error:',xhr.responseText); showToast('Lỗi tải thông tin [HTTP '+xhr.status+']','error');}}); }
    $('#frm').on('submit',function(e){ e.preventDefault(); var name=$.trim($('#txtName').val()); if(!id||!name){showToast('Vui lòng nhập đầy đủ thông tin','error');return;} $('#btnSave').prop('disabled',true).text('Đang lưu...'); $.ajax({url:'@Url.Action("Update","PublisherMgmt")',type:'POST',data:{txt_PublisherId:id,txt_PublisherName:name,chk_IsDeleted:$('#chkIsDeleted').is(':checked')},success:function(res){ console.log('[PublisherMgmt] Update response:',res); if(res&&res.ErrCode===1){showToast(res.ErrDesc||'Cập nhật thành công','success'); setTimeout(function(){window.location.href='@Url.Action("PublisherList","PublisherMgmt")';},700);}else{showToast((res&&res.ErrDesc?res.ErrDesc:'Cập nhật thất bại')+(res&&res.ErrCode!==undefined?' [ErrCode: '+res.ErrCode+']':''),'error');}},error:function(xhr,s,err){console.error('[PublisherMgmt] Update error:',xhr.responseText); showToast('Có lỗi xảy ra [HTTP '+xhr.status+']','error');},complete:function(){$('#btnSave').prop('disabled',false).text('Cập nhật');}}); });
    load();
})();
</script>
}
