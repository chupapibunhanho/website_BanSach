@{
    ViewBag.Title = "Cập nhật nhà xuất bản";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var publisherId = ViewBag.PublisherId;
}
<div class="app-content-header"><div class="container-fluid"><div class="row">
    <div class="col-sm-6"><h3 class="mb-0">Cập nhật nhà xuất bản</h3></div>
    <div class="col-sm-6 text-end"><a href="@Url.Action("PublisherList","PublisherMgmt")" class="btn btn-outline-secondary">Quay lại danh sách</a></div>
</div></div></div>
<div class="app-content"><div class="container-fluid"><div class="card"><div class="card-body">
    <form id="frm">
        <input type="hidden" id="txtId" value="@(publisherId ?? 0)" />
        <div class="mb-3"><label class="form-label">Tên nhà xuất bản <span class="text-danger">*</span></label><input type="text" class="form-control" id="txtName" maxlength="200" /></div>
        <div class="mb-3"><label for="ddlStatus" class="form-label">Trạng thái</label><select class="form-select" id="ddlStatus"><option value="active">Hoạt động</option><option value="deleted">Đã xóa</option></select></div>
        <button type="submit" class="btn btn-primary" id="btnSave">Cập nhật</button>
    </form>
</div></div></div></div>
@section scripts {
<script>
(function(){
    var id=parseInt($('#txtId').val(),10)||0;
    function load(){ if(!id){showToast('Thiếu ID nhà xuất bản','error');return;} $.get('@Url.Action("GetPublisherInfo","PublisherMgmt")',{id:id},function(res){ console.log('[PublisherMgmt] GetPublisherInfo response:',res); if(res&&res.ErrCode===1&&res.Data){$('#txtName').val(res.Data.PublisherName||'');$('#ddlStatus').val(res.Data.IsDeleted?'deleted':'active');} else {var e=(res&&res.ErrDesc?res.ErrDesc:'Không thể tải thông tin')+(res&&res.ErrCode!==undefined?' [ErrCode: '+res.ErrCode+']':''); showToast(e,'error');} }).fail(function(x,s,e){console.error('[PublisherMgmt] GetPublisherInfo error:',{status:s,error:e,httpStatus:x.status,responseText:x.responseText}); showToast('Lỗi tải thông tin [HTTP '+x.status+' '+e+']','error');}); }
    $('#frm').on('submit',function(e){ e.preventDefault(); var name=$.trim($('#txtName').val()); if(!id||!name){showToast('Vui lòng nhập tên nhà xuất bản','error');return;} $('#btnSave').prop('disabled',true).text('Đang lưu...'); $.post('@Url.Action("Update","PublisherMgmt")',{txt_PublisherId:id,txt_PublisherName:name,chk_IsDeleted:($('#ddlStatus').val()==='deleted')},function(res){ console.log('[PublisherMgmt] Update response:',res); if(res&&res.ErrCode===1){showToast(res.ErrDesc||'Cập nhật thành công','success'); setTimeout(function(){window.location.href='@Url.Action("PublisherList","PublisherMgmt")';},700);} else {var e=(res&&res.ErrDesc?res.ErrDesc:'Cập nhật thất bại')+(res&&res.ErrCode!==undefined?' [ErrCode: '+res.ErrCode+']':''); showToast(e,'error');} }).fail(function(x,s,e){console.error('[PublisherMgmt] Update error:',{status:s,error:e,httpStatus:x.status,responseText:x.responseText}); showToast('Lỗi cập nhật [HTTP '+x.status+' '+e+']','error');}).always(function(){$('#btnSave').prop('disabled',false).text('Cập nhật');}); });
    load();
})();
</script>
}