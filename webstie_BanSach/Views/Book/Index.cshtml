@model webstie_BanSach.ViewModels.BookListViewModel
@{ ViewBag.Title = "Danh mục sách"; }
@section styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/home-components.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/book-index.css")" />
}
<div id="book-list-region" aria-live="polite">@Html.Partial("_BookListContent", Model)</div>
<div id="book-load-error" class="alert alert-warning d-none" role="alert">Không thể tải danh sách sách. <button type="button" class="btn btn-sm btn-outline-secondary" id="book-load-retry">Thử lại</button></div>
<div class="modal fade" id="quickViewModal" tabindex="-1" aria-labelledby="quickViewTitle" aria-hidden="true" data-quick-url="@Url.Action("QuickView", "Book")">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
        <div class="modal-header"><h2 class="modal-title fs-5" id="quickViewTitle">Xem nhanh sách</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
        <div class="modal-body" id="quickViewBody"></div>
    </div></div>
</div>
@section scripts { <script src="@Url.Content("~/Scripts/book-index.js")"></script> }
