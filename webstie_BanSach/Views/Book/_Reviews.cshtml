@model webstie_BanSach.ViewModels.ReviewPageViewModel
<form class="review-filter d-flex flex-wrap gap-2 my-3" method="get" action="@Url.Action("Reviews", "Book")">
    <input type="hidden" name="id" value="@Model.BookId" />
    <label class="visually-hidden" for="reviewRating">Số sao</label><select id="reviewRating" class="form-select" name="rating"><option value="">Tất cả số sao</option>@for (var i = 5; i >= 1; i--) { <option value="@i" @(Model.Rating == i ? "selected" : "")>@i sao</option> }</select>
    <label class="visually-hidden" for="reviewSort">Sắp xếp</label><select id="reviewSort" class="form-select" name="sort"><option value="newest" @(Model.Sort == "newest" ? "selected" : "")>Mới nhất</option><option value="highest" @(Model.Sort == "highest" ? "selected" : "")>Cao nhất</option><option value="lowest" @(Model.Sort == "lowest" ? "selected" : "")>Thấp nhất</option></select><button type="submit" class="btn btn-outline-primary">Xem đánh giá</button>
</form>
@if (Model.Reviews.Count == 0) { <p class="text-muted">Chưa có đánh giá phù hợp.</p> }
else { foreach (var review in Model.Reviews) { <article class="review-item"><div class="d-flex justify-content-between flex-wrap gap-2"><strong>@(string.IsNullOrWhiteSpace(review.ReviewerName) ? "Khách hàng" : review.ReviewerName)</strong><time class="text-muted small">@review.CreatedAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm")</time></div><div class="detail-stars" aria-label="@review.Rating sao">@for (var i = 0; i < review.Rating; i++) { <i class="bi bi-star-fill" aria-hidden="true"></i> }</div>@if (!string.IsNullOrWhiteSpace(review.Title)) { <strong>@review.Title</strong> }@if (!string.IsNullOrWhiteSpace(review.Comment)) { <p>@review.Comment</p> }</article> } }
@if (Model.TotalPages > 1) { <nav class="review-pages d-flex gap-2" aria-label="Trang đánh giá">@if (Model.Page > 1) { <a href="@Url.Action("Reviews", "Book", new { id = Model.BookId, rating = Model.Rating, sort = Model.Sort, page = Model.Page - 1 })" class="btn btn-outline-primary btn-sm">Trước</a> }<span>Trang @Model.Page/@Model.TotalPages</span>@if (Model.Page < Model.TotalPages) { <a href="@Url.Action("Reviews", "Book", new { id = Model.BookId, rating = Model.Rating, sort = Model.Sort, page = Model.Page + 1 })" class="btn btn-outline-primary btn-sm">Tiếp</a> }</nav> }
