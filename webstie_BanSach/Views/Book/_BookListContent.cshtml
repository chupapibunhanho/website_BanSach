@model webstie_BanSach.ViewModels.BookListViewModel
@{
    ViewData["EnableQuickView"] = true;
    var bannerName = Model.SelectedCategoryName ?? "Tất cả sách";
    var theme = Math.Abs(bannerName.Aggregate(0, (hash, ch) => (hash * 31 + ch) % 997)) % 4;
    var bannerIcon = "bi-book-half";
    if (bannerName.IndexOf("thiếu nhi", StringComparison.OrdinalIgnoreCase) >= 0) { theme = 2; bannerIcon = "bi-stars"; }
    else if (bannerName.IndexOf("khoa học", StringComparison.OrdinalIgnoreCase) >= 0 || bannerName.IndexOf("công nghệ", StringComparison.OrdinalIgnoreCase) >= 0) { theme = 1; bannerIcon = "bi-lightbulb"; }
    else if (bannerName.IndexOf("kinh tế", StringComparison.OrdinalIgnoreCase) >= 0 || bannerName.IndexOf("kinh doanh", StringComparison.OrdinalIgnoreCase) >= 0) { theme = 3; bannerIcon = "bi-graph-up-arrow"; }
    var cover = Model.BannerBook == null ? null : Model.BannerBook.CoverUrl;
}
<div class="book-list-page container py-4">
    <section class="category-banner category-banner--@theme" aria-label="Giới thiệu danh mục">
        <div class="category-banner__text">
            <div class="category-banner__label"><i class="bi @bannerIcon" aria-hidden="true"></i> NHÀ SÁCH ONLINE</div>
            <h2>@bannerName</h2>
            <p>Khám phá những cuốn sách trong @(Model.SelectedCategoryId.HasValue ? "danh mục này" : "nhà sách của chúng tôi").</p>
            <span>@Model.TotalCount đầu sách</span>
        </div>
        @if (!string.IsNullOrWhiteSpace(cover)) {
            <img class="category-banner__cover" src="@Url.Content(cover)" data-fallback="@Url.Content("~/Content/Images/default-book.jpg")" alt="Bìa sách @Model.BannerBook.Title" />
        }
        else { <i class="bi bi-book category-banner__placeholder" aria-hidden="true"></i> }
    </section>
    <div class="d-flex flex-wrap justify-content-between align-items-start align-items-md-center gap-3 mb-3">
        <div><h2 class="mb-1">Danh mục sách</h2><p class="text-muted mb-0">Khám phá sách theo thể loại.</p></div>
        <button type="button" class="btn btn-outline-primary d-flex align-items-center gap-2" title="Bộ lọc sẽ được triển khai sau" disabled><i class="bi bi-funnel" aria-hidden="true"></i><span>Bộ lọc</span></button>
    </div>
    <nav class="book-categories d-flex flex-wrap gap-2 mb-3" aria-label="Danh mục sách">
        <a class="filter-chip text-decoration-none @(Model.SelectedCategoryId == null ? "active" : "")" href="@Url.Action("Index", "Book")">Tất cả (@Model.AllBooksCount)</a>
        @foreach (var category in Model.Categories)
        {
            <a class="filter-chip text-decoration-none @(Model.SelectedCategoryId == category.CategoryId ? "active" : "")" href="@Url.Action("Index", "Book", new { categoryId = category.CategoryId })">@category.Name (@category.Count)</a>
        }
    </nav>
    <div class="d-flex flex-wrap filter-summary mb-3">
        @if (Model.SelectedCategoryId.HasValue) { <span class="chip"><i class="bi bi-bookmark" aria-hidden="true"></i> @Model.SelectedCategoryName</span> }
        <span class="chip bg-light text-muted"><i class="bi bi-search" aria-hidden="true"></i> @Model.TotalCount kết quả</span>
    </div>
    <div class="book-view-controls mb-3" role="group" aria-label="Chế độ hiển thị">
        <button type="button" class="btn btn-outline-primary" data-view-mode="grid" aria-label="Dạng lưới" aria-pressed="true"><i class="bi bi-grid-3x3-gap" aria-hidden="true"></i></button>
        <button type="button" class="btn btn-outline-primary" data-view-mode="list" aria-label="Dạng danh sách" aria-pressed="false"><i class="bi bi-list-ul" aria-hidden="true"></i></button>
    </div>
    @if (Model.Books.Count > 0)
    {
        <div class="book-grid">
            @foreach (var book in Model.Books) { @Html.Partial("_BookCard", book) }
        </div>
    }
    else { <p class="text-muted">Chưa có sách trong danh mục này.</p> }
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4 pager" aria-label="Phân trang">
            @if (Model.PageNumber > 1) { <a class="page-link" href="@Url.Action("Index", "Book", new { categoryId = Model.SelectedCategoryId, page = Model.PageNumber - 1 })" aria-label="Trang trước">&lsaquo;</a> }
            @for (var p = Math.Max(1, Model.PageNumber - 2); p <= Math.Min(Model.TotalPages, Model.PageNumber + 2); p++)
            {
                if (p == Model.PageNumber) { <span class="page-link active" aria-current="page">@p</span> }
                else { <a class="page-link" href="@Url.Action("Index", "Book", new { categoryId = Model.SelectedCategoryId, page = p })">@p</a> }
            }
            @if (Model.PageNumber < Model.TotalPages) { <a class="page-link" href="@Url.Action("Index", "Book", new { categoryId = Model.SelectedCategoryId, page = Model.PageNumber + 1 })" aria-label="Trang tiếp">&rsaquo;</a> }
        </nav>
    }
</div>
